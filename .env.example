# Company identity
COMPANY_NAME=Example Company
COMPANY_PUBLIC_URL=http://localhost:8787
COMPANY_FORMS_URL=https://forms.example.com
COMPANY_BRAND_LOGO_URL=http://localhost:8787/static/company-core-logo.svg

# Dashboard authentication. scripts/init_env.sh replaces these placeholders.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=GENERATE_ME
SALES_ACTION_TOKEN=GENERATE_ME
SALES_INTAKE_SECRET=GENERATE_ME
SALES_EMAIL_WEBHOOK_SECRET=GENERATE_ME

# OpenAI-compatible model router (OmniRoute, LiteLLM, or another gateway)
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=
MODEL_FAST=auto/best-fast
MODEL_REASONING=auto/best-reasoning
MODEL_FREE=auto/best-free
MODEL_CODING=auto/best-coding
MODEL_VISION=auto/best-vision

# Optional coding agent
CODING_BASE_URL=http://127.0.0.1:20128/v1
CODING_API_KEY=
CODING_DEFAULT_MODEL=auto/best-coding
CODING_MAX_REPAIR_CYCLES=3
CODING_COMPACT_AFTER_TASKS=6

# Optional media engines. Paths may be absolute or relative to this repository.
COMPANY_CORE_WORKSPACE_ROOT=.
MARKETING_G1_ROOT=engines/g1
MARKETING_G1_BIN=engines/g1/.venv/bin/company-core-g1
MARKETING_G1_ENV_FILE=
MARKETING_G2_ROOT=engines/g2
MARKETING_G2_BIN=engines/g2/.venv/bin/company-core-g2
MARKETING_G2_ENV_FILE=
MARKETING_G2_SHOWCASE=engines/g2/assets/references/replace-with-your-showcase.mp4
MARKETING_G2_OUTRO=engines/g2/assets/references/replace-with-your-outro.png
MARKETING_G3_ROOT=engines/g3
MARKETING_G3_BIN=engines/g3/.venv/bin/company-core-g3
MARKETING_G3_ENV_FILE=engines/g3/config/g3.env
MARKETING_VARIANT_VOICES=en-US-AndrewNeural,en-US-EmmaNeural
MARKETING_VOICE_SPEED=1.04
MARKETING_MEDIA_DEADLINE=18
MARKETING_MEDIA_LIMIT=8
MARKETING_STAGE_TIMEOUT=900
PEXELS_API_KEY=
PIXABAY_API_KEY=
LORDICON_API_TOKEN=
OMNIROUTE_IMAGE_MODEL=

# Prospecting and enrichment providers (all optional)
HUNTER_API_KEY=
APOLLO_API_KEY=
PROSPEO_API_KEY=
LUSHA_API_KEY=
PDL_API_KEY=
CE_API_KEY=
COMPANY_ENRICH_WAIT_FOR_ENRICHMENT=true

# Outbound email and inbound reply tracking
SALES_RESEND_API_KEY=
SALES_RESEND_DOMAIN=example.com
SALES_FROM_NAME=Example Company
SALES_FROM_EMAIL=sales@example.com
SALES_REPLY_TO_EMAIL=sales@example.com
SALES_RESEND_WEBHOOK_SECRET=
SALES_AUTO_CONTACT_ENABLED=false
SALES_AUTO_CONTACT_SOURCES=website,popup_offer,quiz_funnel,post_form,social_form

# Forms, attribution, and scheduling
MARKETING_CTA_URL=https://forms.example.com
MARKETING_POPUP_OFFER=operations checklist
MARKETING_FORMS_BASE_URL=https://forms.example.com
TALLY_API_KEY=
TALLY_WEBHOOK_SECRET=
SALES_PUBLIC_BASE_URL=http://localhost:8787
SALES_SCHEDULE_URL=http://localhost:8787/meet
SALES_CALENDAR_BASE_URL=http://localhost:3000
SALES_CALENDAR_EVENT_PATH=book/company
SALES_CALENDAR_BOOKING_URL=
SALES_CALENDAR_EMBED_URL=

# Legacy inbox relay is disabled unless both values are supplied.
SALES_INBOX_URL=
SALES_INBOX_TOKEN=
